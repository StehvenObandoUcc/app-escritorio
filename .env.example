# Copia este archivo como ".env" (nunca se sube al repo) y rellena los valores.
# Solo las variables que empiezan por VITE_ llegan a la app. NUNCA pongas aquí
# la clave service_role de Supabase ni una clave de IA.

# "mock" = datos de ejemplo (por defecto). "tauri" = comandos reales de Rust (desde F1).
VITE_BRIDGE=mock

# Desde F2. Panel de Supabase → Project Settings → API:
#   URL:   https://<project-ref>.supabase.co   (el project-ref está en Project Settings → General)
#   Clave: la pública ("anon" o "publishable"). La "service_role" o "secret" NO va aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
